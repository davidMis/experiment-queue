{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:experiment-queue:schema:experiment-card:v1",
  "$comment": "Immutable ExperimentCard/v1 scientific intent and explicit job contract; mutable scheduling policy is intentionally absent.",
  "title": "experiment-queue ExperimentCard v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "experiment-queue/v1"},
    "kind": {"const": "ExperimentCard"},
    "metadata": {"$ref": "#/$defs/cardMetadata"},
    "spec": {"$ref": "#/$defs/cardSpec"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "projectKey": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "logicalName": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "portableRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!~(?:/|$))(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\u0000-\\u001F\\u007F\\u0085\\u2028\\u2029]+(?![\\s\\S])"
    },
    "protocolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind"],
      "properties": {
        "apiVersion": {"const": "experiment-queue/v1"},
        "kind": {
          "enum": ["CooperativeYieldRequest", "CooperativeYieldReceipt"]
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/projectKey"},
      "additionalProperties": {"type": "object"}
    },
    "cardMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectKey", "experimentId", "title"],
      "properties": {
        "projectKey": {"$ref": "#/$defs/projectKey"},
        "experimentId": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "description": {"type": "string", "maxLength": 12000},
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        }
      }
    },
    "argvCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "argv"],
      "properties": {
        "type": {"const": "argv"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]+(?![\\s\\S])"
            }
          ],
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000]*(?![\\s\\S])"
          }
        }
      }
    },
    "wrapperCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {"const": "wrapper"},
        "path": {"$ref": "#/$defs/portableRelativePath"},
        "args": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000]*(?![\\s\\S])"
          }
        }
      }
    },
    "shellCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "script", "compatibilityReason"],
      "properties": {
        "type": {"const": "shell"},
        "script": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+(?![\\s\\S])"
        },
        "compatibilityReason": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "command": {
      "oneOf": [
        {"$ref": "#/$defs/argvCommand"},
        {"$ref": "#/$defs/wrapperCommand"},
        {"$ref": "#/$defs/shellCommand"}
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpus": {"type": "integer", "minimum": 0, "maximum": 1},
        "cpus": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "memoryBytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "wallTimeSeconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "root", "path", "type"],
      "properties": {
        "name": {"$ref": "#/$defs/logicalName"},
        "root": {"$ref": "#/$defs/logicalName"},
        "path": {"$ref": "#/$defs/portableRelativePath"},
        "type": {"enum": ["file", "directory"]},
        "required": {"type": "boolean"},
        "description": {"type": "string", "maxLength": 1000}
      }
    },
    "provenanceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": {"$ref": "#/$defs/logicalName"},
        "source": {"type": "string", "minLength": 1, "maxLength": 2000},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cooperativeYield": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestProtocol",
            "receiptProtocol",
            "checkpointArtifacts"
          ],
          "properties": {
            "requestProtocol": {
              "allOf": [
                {"$ref": "#/$defs/protocolIdentity"},
                {"properties": {"kind": {"const": "CooperativeYieldRequest"}}}
              ]
            },
            "receiptProtocol": {
              "allOf": [
                {"$ref": "#/$defs/protocolIdentity"},
                {"properties": {"kind": {"const": "CooperativeYieldReceipt"}}}
              ]
            },
            "checkpointArtifacts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/logicalName"}
            }
          }
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "environment", "command"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "role": {"enum": ["independent", "coordinator", "worker"]},
        "description": {"type": "string", "maxLength": 4000},
        "environment": {"$ref": "#/$defs/logicalName"},
        "workingDirectory": {"$ref": "#/$defs/portableRelativePath"},
        "command": {"$ref": "#/$defs/command"},
        "parameters": {"type": "object"},
        "resources": {"$ref": "#/$defs/resources"},
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/provenanceInput"}
        },
        "notes": {"type": "string", "maxLength": 12000}
      }
    },
    "cardSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters", "jobs"],
      "properties": {
        "parameters": {"type": "object"},
        "jobs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/job"}
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }
}
