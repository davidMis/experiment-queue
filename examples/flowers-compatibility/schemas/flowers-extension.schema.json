{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flowers-3d-helmholtz:experiment-queue-extension:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "integration": {"const": "local-cutover-fixture"}
      },
      "required": ["integration"]
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {"enum": ["simple", "tracked", "specfem"]}
      },
      "required": ["family"]
    },
    "jobs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tracker": {"enum": ["none", "wandb"]},
          "solver": {"enum": ["python", "specfem"]},
          "elastic": {"type": "boolean"}
        }
      }
    }
  }
}
